{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeon-architect-ai.local/schema/dungeon-layout-exchange-v1.json",
  "title": "DungeonLayoutExchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "id",
    "source",
    "coordinateSystem",
    "floors"
  ],
  "properties": {
    "schema": { "const": "dungeon-layout-exchange" },
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "dungeonSpecVersion"],
      "properties": {
        "application": { "const": "Dungeon Architect AI" },
        "dungeonSpecVersion": { "const": "1.0" },
        "generatorStrategyId": { "type": "string", "minLength": 1 },
        "generatorVersion": { "type": "string", "minLength": 1 },
        "algorithmVersion": { "type": "string", "minLength": 1 },
        "contentLayerVersion": { "type": "string", "minLength": 1 }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plane",
        "units",
        "roomPosition",
        "roomSize",
        "positiveX",
        "positiveZ"
      ],
      "properties": {
        "plane": { "const": "XZ" },
        "units": { "const": "abstract" },
        "roomPosition": { "const": "center" },
        "roomSize": { "const": "full-extent" },
        "positiveX": { "const": "east" },
        "positiveZ": { "const": "south" }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/floor" }
    }
  },
  "$defs": {
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "dungeonId",
        "seed",
        "rooms",
        "connections"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "dungeonId": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "rooms": {
          "type": "array",
          "items": { "$ref": "#/$defs/room" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/connection" }
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "z", "width", "depth", "roles"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["start", "goal"] }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromRoomId",
        "toRoomId",
        "width",
        "enabled"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromRoomId": { "type": "string", "minLength": 1 },
        "toRoomId": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "enabled": { "type": "boolean" },
        "kind": { "type": "string", "minLength": 1 },
        "fromSide": {
          "enum": ["north", "east", "south", "west"]
        },
        "toSide": {
          "enum": ["north", "east", "south", "west"]
        }
      }
    }
  }
}
